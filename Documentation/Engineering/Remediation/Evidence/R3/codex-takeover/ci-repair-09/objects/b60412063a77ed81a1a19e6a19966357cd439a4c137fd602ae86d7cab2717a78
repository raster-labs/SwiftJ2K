+// DIAGNOSTIC OVERLAY ONLY. Do not merge this phase tracer.
+import Foundation
+import Synchronization
+
+package final class JPIPHTTPSPhaseTrace: Sendable {
+    private struct Event: Sendable { let stamp: UInt64; let owner: String; let event: String }
+    private final class Store: Sendable { let events = Mutex<[Event]>([]) }
+    private static let stores = Mutex<[Store]>([])
+    private static let correlation = Store()
+    private static let output = Mutex(())
+    private let store = Store()
+    private let once = Mutex<Set<String>>([])
+    package let id = UUID().uuidString
+    package init() { Self.stores.withLock { $0.append(store) } }
+    package static func record(owner: String, event: String) {
+        let stamp = DispatchTime.now().uptimeNanoseconds
+        correlation.events.withLock { $0.append(Event(stamp: stamp, owner: owner, event: event)) }
+    }
+    package static func flush() {
+        let captures = [correlation] + stores.withLock { $0 }
+        var completed: [Event] = []
+        for capture in captures {
+            completed += capture.events.withLock { stored in
+                let result = stored
+                stored = []
+                return result
+            }
+        }
+        output.withLock { _ in
+            for item in completed {
+                print("HTTPS_PHASE ns=\(item.stamp) owner=\(item.owner) event=\(item.event)")
+            }
+        }
+    }
+    package func mark(_ event: String) {
+        let stamp = DispatchTime.now().uptimeNanoseconds
+        store.events.withLock { $0.append(Event(stamp: stamp, owner: id, event: event)) }
+    }
+    package func first(_ event: String) {
+        if once.withLock({ $0.insert(event).inserted }) { mark(event) }
+    }
+}
