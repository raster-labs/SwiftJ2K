#!/usr/bin/env python3
"""Prepare a new immutable final selection; no native or repository writes."""
from datetime import datetime, timezone
from pathlib import Path
import hashlib
import json
import re

OUT = Path(__file__).resolve().parent
WORK = OUT.parent
WORKSPACE = WORK.parent
BASE = OUT / 'manifest-preparation-03.json'
HELPER = WORK / 'ci-repair-evidence-14/package.py'
HELPER_SHA = '588df7bb3fb8f100703d8cf6fc471d68ee692365974be9c18874ab72114dca83'
PRIOR_SHA = '6dfeb1e3b90266e54d847e7ce1a5bf9096748e5d9611ed33e0a07568526f2e54'

def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def ref(path):
    assert path.is_file() and not path.is_symlink(), path
    return {'path': str(path), 'sha256': sha(path)}

def save(name, value):
    with (OUT / name).open('x') as stream:
        json.dump(value, stream, indent=2)
        stream.write('\n')

def load(name):
    return json.loads((WORK / name).read_text())

assert sha(HELPER) == HELPER_SHA
assert sha(BASE) == '5b543e9bda84cd06a202089fde8de261befb80737ce62e1c4d46d237f167c1ce'
helper_review = load('ci-repair-evidence-14/root-helper-review-14.json')
assert helper_review['state'] == 'REVIEWED_BOUNDED_HELPER_CHANGE'
assert helper_review['inputs'][str(HELPER)] == HELPER_SHA
manifest = json.loads(BASE.read_text())
assert manifest['prior_index']['sha256'] == PRIOR_SHA
manifest['candidate_label'] = (
    'Candidate15 final local evidence: seven completed15 gates, independently reconciled '
    'ordinary/full partitioned TSan and ASan, explicit input-equivalent release/CLI14 reuse, '
    'stopped source/documentation reviews; historical failures preserved; '
    'exact-head hosted CI follows supplement publication; R3 NOT_ACCEPTED')

def verify_refs(value):
    if isinstance(value, dict):
        if 'path' in value and 'sha256' in value:
            path = Path(value['path'])
            if not path.is_absolute():
                path = WORKSPACE / path
            assert sha(path) == value['sha256'], path
        for entry in value.values():
            verify_refs(entry)
    elif isinstance(value, list):
        for entry in value:
            verify_refs(entry)

verify_refs(manifest)
selected_runs = {Path(entry['result']['path']).parent.name for entry in manifest['native_runs']}
plan15 = load('planned-native-sequence-15.json')
completed15 = []
for gate in plan15['gates']:
    label = gate['label']
    directory = WORK / 'validation' / label
    result = json.loads((directory / 'result.json').read_text())
    assert result.get('finished_at') and result.get('exit_code') == 0, label
    completed15.append(label)
    if label not in selected_runs:
        entry = {key: ref(directory / filename) for key, filename in (
            ('result', 'result.json'), ('command', 'command.json'),
            ('before', 'source-before.json'), ('after', 'source-after.json'))}
        entry['reports'] = [ref(path) for path in sorted(directory.rglob('*.xml'))]
        entry['diagnostic_only'] = False
        manifest['native_runs'].append(entry)
        selected_runs.add(label)
assert len(completed15) == 7
observed_completed = {
    directory.name for directory in (WORK / 'validation').iterdir()
    if directory.is_dir() and re.search(r'-(09|10|11|12|13|14|15)$', directory.name)
    and (directory / 'result.json').is_file()
}
assert selected_runs == observed_completed, (selected_runs ^ observed_completed)
assert not (WORK / 'validation/candidate-complement-asan-14/result.json').exists()
assert not (WORK / 'r3-sanitizer-execution-proof-address-14.json').exists()

decision = load('r3-sanitizer-decision-15.json')
assert decision['state'] == 'QUALIFIED_LOCAL_PARTITIONED_NATIVE'
assert decision['r3_acceptance'] == 'NOT_ACCEPTED'
assert decision['merge_allowed'] is False and decision['r4_allowed'] is False
assert len(decision['unexecuted_unwaived_gates']) == 5
for name, expected in decision['inputs'].items():
    assert sha(Path(name)) == expected, name

docs = load('independent-publication-doc-review-15-source.json')
assert docs['state'] == 'SCOPED_PUBLICATION_DOCUMENT_REVIEW_COMPLETE'
assert docs['stable_corrected_inputs'] is True
for name, expected in docs['files'].items():
    assert sha(Path(name)) == expected, name

binding = load('runtime-coverage-15/final-review-binding.json')
assert binding['state'] == 'LOCAL_REVIEW_COMPLETE_STOPPED'
for field, name in [
    ('audit_sha256', 'runtime-coverage-15/final-review-source.json'),
    ('report_sha256', 'runtime-coverage-15/final-review.txt'),
    ('thread_proof_sha256', 'r3-sanitizer-execution-proof-thread-15.json'),
    ('address_proof_sha256', 'r3-sanitizer-execution-proof-address-15.json'),
    ('source_manifest_sha256', 'candidate-snapshot-15-source.json'),
]:
    assert sha(WORK / name) == binding[field], name
for kind in ['thread', 'address']:
    proof = load(f'r3-sanitizer-execution-proof-{kind}-15.json')
    assert proof['state'] == 'COMPLETE_PARTITIONED_RUNTIME_COVERAGE'
    assert proof['declared_tests'] == 1358
    assert proof['parameter_declarations'] == 38
    assert proof['parameter_argument_starts'] == 406
    assert proof['unexecuted_declarations'] == []
    assert proof['helper_sha256'] == sha(WORK / 'runtime-coverage/reconcile.py')

new_pairs = [
    ('runtime-coverage-15/final-review.txt', 'runtime-coverage-15/final-review-source.json',
     ['runtime-coverage-15/final-review-binding.json']),
    ('independent-final-native-review-15.txt', 'independent-final-native-review-15-source.json',
     ['independent-final-native-check-15.py']),
    ('independent-publication-doc-review-15.txt', 'independent-publication-doc-review-15-source.json',
     ['independent-publication-doc-review-15-before.json',
      'independent-publication-doc-review-15-corrected-before.json']),
]
for report, source, support in new_pairs:
    source_json = load(source)
    if str(WORK / report) in source_json.get('files', {}):
        assert source_json['files'][str(WORK / report)] == sha(WORK / report)
    manifest['reviews'].append({
        'report': ref(WORK / report), 'source': ref(WORK / source), 'completed': True,
        'supporting': [ref(WORK / name) for name in support],
    })

failed_runs = []
for entry in manifest['native_runs']:
    result = json.loads(Path(entry['result']['path']).read_text())
    if result['exit_code'] != 0:
        failed_runs.append({
            'label': Path(entry['result']['path']).parent.name,
            'exit_code': result['exit_code'], 'result': entry['result'],
            'scope': 'Historical failed receipt retained without reclassification.',
        })
scope = {
    'state': 'FINAL_LOCAL_SELECTION_READY_FOR_ROOT_REVIEW_NOT_PUBLISHED',
    'prepared_at': datetime.now(timezone.utc).isoformat(),
    'candidate': 'candidate-snapshot-15',
    'source_manifest': ref(WORK / 'candidate-snapshot-15-source.json'),
    'local_gate_decision': ref(WORK / 'r3-sanitizer-decision-15.json'),
    'completed15': completed15,
    'ordinary': decision['ordinary'], 'sanitizers': decision['sanitizers'],
    'release_cli': decision['release_cli'],
    'retained_failed_supplement_runs': failed_runs,
    'older_failure_history': {
        'source': 'Immutable published08 corpus and separately retained final15 independent reviews.',
        'prior_index_sha256': PRIOR_SHA,
        'scope': 'No old failure is converted into a pass or attributed solely to later queue/fixture repairs.',
    },
    'candidate14_address': {
        'jpip': 'FAILED; three WebSocket barrier arguments remain failed.',
        'complement': 'UNEXECUTED; no completed receipt or address14 proof exists.',
    },
    'first_hosted_run': {
        'run_id': 41186617163, 'attempt': 1, 'completed_job_logs': 7,
        'scope': 'Failed first hosted attempt retained; no exact new-head hosted pass inferred.',
    },
    'stopped_documentation': {
        'review': ref(WORK / 'independent-publication-doc-review-15-source.json'),
        'corrected_inputs': docs['corrected_doc_hashes'],
        'pr_body': 'Only r3-pr-body-reviewed-local-15.txt is selected; future link-substituted PR body stays separate.',
    },
    'prepublication': {
        'pending_evidence_inputs': [],
        'remaining_actions': [
            'Root independently reviews this final explicit manifest and read-only dry run.',
            'Root verifies its existing exclusive coordinator claim and stopped writers before publication.',
        ],
        'writer_state_basis': 'Root coordination message reports native/source/CI/docs/local-body writers stopped; independent final reviews record positive stops.',
    },
    'postpublication_pending': {
        'order': 'Reviewed local supplement publication precedes feature commit/push and subsequent exact-head hosted CI.',
        'receipts': [
            'Feature head/tree/base/tested-merge identities and independently verified PR/index links.',
            'New exact-head hosted macOS26/Linux metadata, every raw job log, retention/runtime/argument review.',
            'PR body link-only substitution using verified publication and hosted-run links.',
        ],
        'storage': 'Retain separately in work/outputs and PR links; not prerequisites to initial local supplement publication.',
    },
    'external_gates': {'state': 'UNEXECUTED_UNWAIVED', 'gates': decision['unexecuted_unwaived_gates']},
    'R3': 'NOT_ACCEPTED', 'merge_allowed': False, 'R4': 'GATED',
    'scope_limits': decision['scope_limits'],
    'excluded': [
        'Binaries, build/cache directories and complete source snapshot trees.',
        'Broad unrelated application/project inventory: environment-after.json and other-native-after.txt.',
        'Future publication-link PR bodies and postpublication hosted receipts not yet produced.',
    ],
    'preparation_agent_actions': 'Read-only receipt verification and new work preparation files only; no native/repository/Git/network/publication execution.',
}
save('final-local-scope-15.json', scope)

extra = [WORK / name for name in [
    'r3-sanitizer-execution-proof-thread-15.json',
    'r3-sanitizer-execution-proof-address-15.json',
    'r3-sanitizer-decision-15.json', 'r3-performance-decision-08.json',
    'runtime-coverage/reconcile.py',
    'sanitizer-partition-proposal/verify-sanitizer-inventory.py',
    'independent-final-native-check-15.py',
    'independent-publication-doc-review-15-before.json',
    'independent-publication-doc-review-15-corrected-before.json',
    'r3-pr-body-reviewed-local-15.txt',
    'SwiftJ2K/Documentation/Engineering/Remediation/STATUS.md',
    'SwiftJ2K/Documentation/Engineering/Remediation/R3_CAPABILITY_MATRIX.md',
    'candidate-snapshot-03-source.json', 'candidate-snapshot-04-source.json',
    'candidate-snapshot-14/Tests/SwiftJ2KJPIPTests/CodexR3WebSocketLifecycleTests.swift',
    'ci-repair-evidence-14/manifest-preparation-02.json',
    'ci-repair-evidence-14/pending-inputs-02.json',
]]
suffixes = {'.json', '.jsonl', '.txt', '.log', '.stdout', '.stderr', '.xml', '.ids',
            '.py', '.swift', '.patch', '.diff', '.md', '.yml', '.yaml', '.csv'}
for name in ['runtime-coverage-15', 'sanitizer-inventory-15']:
    for path in sorted((WORK / name).rglob('*')):
        if path.is_file() and '__pycache__' not in path.parts:
            assert path.suffix.lower() in suffixes, path
            extra.append(path)
for name in [
    'manifest-preparation-01.json', 'manifest-preparation-02.json', 'manifest-preparation-03.json',
    'pending-inputs-01.json', 'pending-inputs-02.json', 'pending-inputs-03.json',
    'report.txt', 'source.json', 'report-03.txt', 'source-03.json',
    'dry-run-02.json', 'dry-run-02.stdout', 'dry-run-02.stderr',
    'dry-run-03.json', 'dry-run-03.stdout', 'dry-run-03.stderr',
    'current-ci-identity-note.json', 'final-local-scope-15.json', 'prepare_final_manifest.py',
]:
    extra.append(OUT / name)
already = {entry['file']['path'] for entry in manifest['supplemental']}
for path in sorted(set(extra)):
    if str(path) not in already:
        manifest['supplemental'].append({
            'file': ref(path),
            'role': 'supplement-' + path.relative_to(WORK).as_posix().replace('/', '--'),
        })
        already.add(str(path))

excluded = {
    str(WORK / 'https-full-concurrency-diagnosis-12/environment-after.json'),
    str(WORK / 'https-full-concurrency-diagnosis-12/other-native-after.txt'),
}
assert not (already & excluded)
assert not any('/candidate-build-' in path or '/candidate-asan-' in path
               or '/candidate-tsan-' in path for path in already)
assert all('r3-pr-body' not in path or path.endswith('/r3-pr-body-reviewed-local-15.txt')
           for path in already)
verify_refs(manifest)
save('manifest-final-15.json', manifest)
save('selection-final-15.json', {
    'state': 'FINAL_EXPLICIT_SELECTION_NOT_PUBLISHED',
    'base_manifest': ref(BASE), 'manifest': ref(OUT / 'manifest-final-15.json'),
    'generator': ref(Path(__file__)), 'scope': ref(OUT / 'final-local-scope-15.json'),
    'reviewed_helper': ref(HELPER),
    'native_runs': len(manifest['native_runs']), 'review_pairs': len(manifest['reviews']),
    'hosted_runs': len(manifest['hosted_runs']), 'supplemental_receipts': len(manifest['supplemental']),
    'all_completed_native09_through15_selected': True,
    'completed15': completed15, 'prepublication_missing_evidence': [],
    'postpublication_hosted_ci': 'PENDING_FEATURE_PUBLICATION',
    'R3': 'NOT_ACCEPTED',
})
print(json.dumps({
    'manifest': str(OUT / 'manifest-final-15.json'),
    'manifest_sha256': sha(OUT / 'manifest-final-15.json'),
    'native_runs': len(manifest['native_runs']), 'review_pairs': len(manifest['reviews']),
    'supplemental_receipts': len(manifest['supplemental']),
}, indent=2))
