from pathlib import Path
import hashlib, json, os, subprocess, sys
w = Path(__file__).resolve().parent
plan = json.loads((w / "planned-native-sequence-15.json").read_text())
assert hashlib.sha256((w / "run-validation.py").read_bytes()).hexdigest() == plan["wrapper_sha256"]
assert hashlib.sha256((w / "candidate-snapshot-15-source.json").read_bytes()).hexdigest() == plan["source_manifest_sha256"]
env = os.environ.copy()
env["SWIFTJ2K_VALIDATION_SOURCE"] = plan["source"]
for gate in plan["gates"]:
    print("Starting serial gate " + gate["label"], flush=True)
    code = subprocess.run([sys.executable, str(w / "run-validation.py"), gate["label"], *gate["command"]], cwd=w.parent, env=env).returncode
    if code:
        print("Stopped after failed gate " + gate["label"], flush=True)
        sys.exit(code)
print("All planned native gates completed; independent reconciliation still required.", flush=True)
