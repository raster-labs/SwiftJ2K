def save(path,before,after):
    p=overlay/path;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(after)
    manifest[path]={'base_sha256':hashlib.sha256(before.encode()).hexdigest() if before else None,'instrumented_sha256':hashlib.sha256(after.encode()).hexdigest()}
def replace(text,old,new,count=1):
    assert text.count(old)==count,(old,text.count(old),count)
    return text.replace(old,new)
