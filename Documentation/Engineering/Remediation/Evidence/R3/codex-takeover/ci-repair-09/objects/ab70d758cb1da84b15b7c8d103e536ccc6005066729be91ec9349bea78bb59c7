#!/usr/bin/env python3
"""Reconcile focused24 (candidate-https-focused-24) and hosted22 (run-41201993850)."""

from pathlib import Path
from datetime import datetime, timezone
from collections import Counter
import hashlib
import json
import re
import subprocess
import sys
import xml.etree.ElementTree as ET

OUT = Path(__file__).resolve().parent
WORK = OUT.parent
ROOT = WORK.parent
DOWNLOADS = WORK / "ci-downloads"
RUN = 41201993850
MAC = 124539451449
STAMP = re.compile(r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,9})?Z (.*)$")
ANSI = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")


def sha(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def save(name: str, value: object) -> None:
    (OUT / name).write_text(json.dumps(value, indent=2) + "\n")


def unique(pairs):
    result = {}
    for key, value in pairs:
        assert key not in result, key
        result[key] = value
    return result


def read_dl(name: str):
    return json.loads((DOWNLOADS / name).read_text(), object_pairs_hook=unique)


# 1. focused24 reconciliation
val = WORK / "validation/candidate-https-focused-24"
snap = WORK / "candidate-snapshot-24"
repo = WORK / "SwiftJ2K"

res24 = json.loads((val / "result.json").read_text())
stdout24 = (val / "native.stdout").read_text()
stderr24 = (val / "native.stderr").read_text()
xml_root24 = ET.fromstring((val / "report-swift-testing.xml").read_text())
suite24 = xml_root24.find("testsuite")
cases24 = xml_root24.findall(".//testcase")

tracked = subprocess.check_output(
    ["git", "-C", str(repo), "ls-files", "-co", "--exclude-standard"], text=True
).splitlines()


def is_impl_input(rel: str) -> bool:
    if rel == "Package.swift":
        return True
    parts = Path(rel).parts
    if not parts or parts[0] not in ("Sources", "Tests", "Scripts"):
        return False
    return not any(part == "__pycache__" or part.endswith(".pyc") for part in parts)


impl_inputs = [rel for rel in tracked if is_impl_input(rel)]
changed_from_snap = [rel for rel in tracked if sha(repo / rel) != sha(snap / rel)]
patch_file = ROOT / "outputs/SwiftJ2K-R3-Unpublished-Harness-24.patch"
before_bytes = subprocess.check_output(
    ["git", "-C", str(repo), "show", "HEAD:Tests/SwiftJ2KJPIPTests/CodexR3HTTPStreamingTests.swift"]
)
current_test_file = repo / "Tests/SwiftJ2KJPIPTests/CodexR3HTTPStreamingTests.swift"

arg_lines24 = [l for l in stdout24.splitlines() if "started" in l and "→" in l]
warning_lines24 = [l for l in (stdout24 + "\n" + stderr24).splitlines() if "warning:" in l]

focused24_summary = {
    "artifact_dir": str(val),
    "result_json": res24,
    "result_json_sha256": sha(val / "result.json"),
    "native_stdout_sha256": sha(val / "native.stdout"),
    "native_stderr_sha256": sha(val / "native.stderr"),
    "report_swift_testing_xml_sha256": sha(val / "report-swift-testing.xml"),
    "xml_summary": suite24.attrib if suite24 is not None else xml_root24.attrib,
    "xml_testcase_names": [c.attrib["name"] for c in cases24],
    "parameterized_argument_starts_count": len(arg_lines24),
    "parameterized_argument_starts": arg_lines24,
    "tracked_unignored_files_count": len(tracked),
    "implementation_inputs_count": len(impl_inputs),
    "changed_files_vs_snapshot_24": changed_from_snap,
    "unpublished_harness_patch": {
        "file": "Tests/SwiftJ2KJPIPTests/CodexR3HTTPStreamingTests.swift",
        "before_head_sha256": hashlib.sha256(before_bytes).hexdigest(),
        "current_sha256": sha(current_test_file),
        "snapshot24_sha256": sha(snap / "Tests/SwiftJ2KJPIPTests/CodexR3HTTPStreamingTests.swift"),
        "patch_sha256": sha(patch_file),
    },
    "compiler_warnings": warning_lines24,
    "line_550_warning_analysis": (
        "CodexR3HTTPStreamingTests.swift:550 emits a Swift compiler warning because "
        "startLoading() binds `let client = self.client` in the outer DispatchWorkItem "
        "and implicitly captures `client` strongly in that finite setup closure while "
        "capturing `[weak self, weak client]` in the nested repeating timer closure. "
        "Runtime ownership is sound (outer setup work item runs once and exits; repeating "
        "timer holds `client` weakly), and capturing `[weak self, weak client = client]` "
        "or `[self, client]` in the outer closure eliminates the warning cleanly."
    ),
}
save("focused24-reconciliation.json", focused24_summary)

# 2. hosted22 reconciliation
metadata = read_dl(f"run-{RUN}-attempt1-jobs.json")
initial = read_dl(f"run-{RUN}-attempt1-initial.json")
final = read_dl(f"run-{RUN}-attempt1-final.json")
merge = read_dl(f"run-{RUN}-tested-merge.json")
jobs = metadata["jobs"]
assert len(jobs) == 7 and len({job["id"] for job in jobs}) == 7
assert all(job["run_id"] == RUN and job["status"] == "completed" and job["conclusion"] for job in jobs)
mac = next(job for job in jobs if job["id"] == MAC)
steps = {step["name"]: step["conclusion"] for step in mac["steps"]}
assert steps["Run swift build"] == "success" and steps["Ordinary tests"] == "failure"
assert steps["Address sanitizer"] == steps["Thread sanitizer"] == "skipped"
assert steps["Retain exact test evidence in downloadable logs"] == "failure"
assert initial["id"] == RUN and initial["run_attempt"] == 1 and initial["event"] == "pull_request"
pr = initial["pull_requests"][0]
assert initial["head_sha"] == pr["head"]["sha"] and pr["number"] == 30
assert [parent["sha"] for parent in merge["parents"]] == [pr["base"]["sha"], pr["head"]["sha"]]

logs = {job["id"]: DOWNLOADS / f"run-{RUN}-attempt1-job{job['id']}.log" for job in jobs}
expected = {
    "identity": {
        "GITHUB_REPOSITORY": initial["repository"]["full_name"],
        "GITHUB_RUN_ID": str(RUN),
        "GITHUB_RUN_ATTEMPT": "1",
        "GITHUB_JOB": "macos",
        "GITHUB_EVENT_NAME": "pull_request",
        "GITHUB_REF": f"refs/pull/{pr['number']}/merge",
        "GITHUB_SHA": merge["sha"],
        "EVIDENCE_PR_HEAD": pr["head"]["sha"],
        "EVIDENCE_PR_BASE": pr["base"]["sha"],
        "EVIDENCE_ORDINARY": steps["Ordinary tests"],
        "EVIDENCE_ASAN": steps["Address sanitizer"],
        "EVIDENCE_TSAN": steps["Thread sanitizer"],
    },
    "checkout_head": merge["sha"],
    "checkout_tree": merge["tree"]["sha"],
}
save("expected-from-supplied-metadata-22.json", expected)

mac_lines, records = [], []
for number, raw in enumerate(logs[MAC].read_text().split("\n"), 1):
    match = STAMP.fullmatch(raw.rstrip("\r"))
    message = match[1] if match else raw
    mac_lines.append((number, ANSI.sub("", message)))
    if message.startswith("{") and "swiftj2k-ci-evidence-v1" in message:
        assert match is not None
        record = json.loads(message, object_pairs_hook=unique)
        if record.get("format") == "swiftj2k-ci-evidence-v1":
            records.append((number, record))

assert records[0][1]["kind"] == "begin" and records[-1][1]["kind"] == "end"
begin, end = records[0][1], records[-1][1]
assert begin["identity"] == expected["identity"]
assert begin["checkout_head"] == expected["checkout_head"] and begin["checkout_tree"] == expected["checkout_tree"]
assert begin["tracked_tree_clean"] is True

inventory_names = [
    "reference.stdout", "reference.stderr", "reference.command-result.json",
    "sanitized.stdout", "sanitized.stderr", "sanitized.command-result.json", "inventory.json",
    "all.ids", "jpip.ids", "complement.ids", "inventory-mismatch.json",
]
allowed = {f"{mode}/{name}" for mode in ["address", "thread"] for name in inventory_names}
allowed |= {"ordinary/full.xml", "ordinary/full-swift-testing.xml"}
allowed |= {
    f"{mode}/{part}{suffix}.xml"
    for mode in ["address", "thread"]
    for part in ["jpip", "complement"]
    for suffix in ["", "-swift-testing"]
}

cursor, recovered, missing, chunk_receipts = 1, {}, [], []
for path in sorted(allowed):
    number, item = records[cursor]
    cursor += 1
    assert item["path"] == path and item["kind"] in ["missing", "file"]
    if item["kind"] == "missing":
        missing.append(path)
        continue
    chunks = []
    for index in range(item["chunks"]):
        line, chunk = records[cursor]
        cursor += 1
        content = chunk["content_utf8"]
        chunks.append(content.encode("utf-8"))
        chunk_receipts.append({"path": path, "index": index, "line": line, "utf8_bytes": len(chunks[-1])})
    data = b"".join(chunks)
    assert len(data) == item["bytes"] and hashlib.sha256(data).hexdigest() == item["sha256"]
    recovered[path] = data

assert cursor == len(records) - 1
assert set(recovered) == {"ordinary/full-swift-testing.xml"}
xml_bytes = recovered["ordinary/full-swift-testing.xml"]
(OUT / "ordinary-diagnostic-swift-testing.xml").write_bytes(xml_bytes)

destination = OUT / "strict-full-reconstruction-must-not-exist"
command = [
    sys.executable,
    str(WORK / "hosted-evidence/reconstruct.py"),
    "--log", str(logs[MAC]),
    "--expected", str(OUT / "expected-from-supplied-metadata-22.json"),
    "--output", str(destination),
]
strict = subprocess.run(command, capture_output=True)
(OUT / "strict-reconstruction.stdout").write_bytes(strict.stdout)
(OUT / "strict-reconstruction.stderr").write_bytes(strict.stderr)
assert strict.returncode != 0 and b"Emitter recorded retention problems or incomplete evidence" in strict.stderr
assert not destination.exists()


def matches(pattern: str):
    return [(line, match.groups()) for line, message in mac_lines if (match := re.fullmatch(pattern, message))]


xstarts = matches(r"Test Case '(.+)' started\.")
xpasses = matches(r"Test Case '(.+)' passed \(.+\)\.")
assert len(xstarts) == len(xpasses) == 1034
starts = matches(r"◇ Test (?!case |run )(.+) started\.")
passed = matches(r"✔ Test (.+?)(?: with (\d+) test cases?)? passed after .+ seconds\.")
failed = matches(r"✘ Test (?!run )(.+?)(?: with (\d+) test cases?)? failed after .+ seconds with \d+ issues?\.")
skipped = matches(r"➜ Test (.+?) skipped: (.+)")
assert len(starts) == 320 and len(passed) == 315 and len(failed) == 5 and len(skipped) == 5
assert len({value[0] for _, value in passed + failed + skipped}) == 325
summary = matches(r"✘ Test run with (\d+) tests in (\d+) suites failed after ([0-9.]+) seconds with (\d+) issues\.")
assert len(summary) == 1
issue_lines = [
    {"line": line, "message": message}
    for line, message in mac_lines
    if message.startswith("✘ Test ") and " recorded an issue" in message
]

cases = ET.fromstring(xml_bytes).findall(".//testcase")
assert len(cases) == 325
xml_status = {"passed": [], "failed": [], "skipped": []}
for case in cases:
    failures, skips = case.findall("failure"), case.findall("skipped")
    kind = "failed" if failures else "skipped" if skips else "passed"
    xml_status[kind].append(
        {
            "class": case.attrib["classname"],
            "name": case.attrib["name"],
            "time": case.attrib.get("time"),
            "messages": [(element.text or "") for element in failures + skips],
        }
    )

linux = []
for job in jobs:
    if "ubuntu-" not in job["name"] or not job["name"].startswith("Swift "):
        continue
    outcomes = {step["name"]: step["conclusion"] for step in job["steps"]}
    assert outcomes["Run swift build"] == "success" and outcomes["Run swift test"] == "failure"
    messages = [
        (number, ANSI.sub("", STAMP.sub(r"\1", raw)))
        for number, raw in enumerate(logs[job["id"]].read_text().split("\n"), 1)
    ]
    build_completions = [(line, text) for line, text in messages if text.startswith("Build complete!")]
    test_entry = next(line for line, text in messages if text == "##[group]Run swift test")
    assert len(build_completions) == 1 and build_completions[0][0] < test_entry
    diagnostics = [
        (line, text)
        for line, text in messages
        if ": error: " in text and "CodexR3HTTPStreamingTests.swift" in text
    ]
    assert diagnostics and all(line > test_entry for line, _ in diagnostics)
    linux.append(
        {
            "job_id": job["id"],
            "name": job["name"],
            "steps": outcomes,
            "build_completion": build_completions[0],
            "test_step_line": test_entry,
            "diagnostics": diagnostics,
            "log_sha256": sha(logs[job["id"]]),
        }
    )
assert len(linux) == 4

hosted22 = {
    "state": "FAILED_HOSTED22_RECONCILED_BY_ANTIGRAVITY_NOT_ACCEPTED",
    "finished_at": datetime.now(timezone.utc).isoformat(),
    "run_id": RUN,
    "attempt": 1,
    "identity": expected,
    "jobs": [
        {"id": job["id"], "name": job["name"], "status": job["status"], "conclusion": job["conclusion"]}
        for job in jobs
    ],
    "macos": {
        "job_id": MAC,
        "steps": steps,
        "xctest_starts": 1034,
        "xctest_passes": 1034,
        "swift_testing_declarations": 325,
        "swift_testing_started": 320,
        "swift_testing_passed": 315,
        "swift_testing_failed": 5,
        "swift_testing_skipped": 5,
        "raw_summary": summary[0],
        "issues": issue_lines,
        "xml_failures": xml_status["failed"],
        "xml_skips": xml_status["skipped"],
    },
    "retention": {
        "begin_line": records[0][0],
        "end_line": records[-1][0],
        "record_count": len(records),
        "diagnostic_only_file": "ordinary-diagnostic-swift-testing.xml",
        "bytes": len(xml_bytes),
        "sha256": hashlib.sha256(xml_bytes).hexdigest(),
        "missing_paths": missing,
        "footer": end,
        "strict_reconstructor_exit": strict.returncode,
        "strict_output_directory_exists": destination.exists(),
    },
    "linux": linux,
}
save("hosted22-reconciliation.json", hosted22)
print("focused24 + hosted22 reconciled successfully!")
for f in xml_status["failed"]:
    print("MACOS FAIL:", f["class"], f["name"], f["time"], "->", f["messages"])
for l in linux:
    print("LINUX FAIL:", l["name"], "error count:", len(l["diagnostics"]), "first:", l["diagnostics"][0])
