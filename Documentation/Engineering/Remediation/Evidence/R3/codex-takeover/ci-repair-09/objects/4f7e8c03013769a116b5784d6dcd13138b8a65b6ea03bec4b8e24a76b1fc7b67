  p=pair(a,b)
  if p:intervals[name]=p
 row['intervals']=intervals
 row['task_priorities']=sorted(set(int(m[1]) for e in ev if (m:=re.search(r'priority=(\d+)',e['event']))))
 row['queue_configs']=sorted(set(e['event'] for e in ev if e['event'].startswith('delegate-queue-config')))
 row['first_read']=first('read-entry');row['read_exit']=first('read-exit')
 assert row['first_read'] and row['read_exit'] and first('caller-woke') and first('continuation-resume-after')
