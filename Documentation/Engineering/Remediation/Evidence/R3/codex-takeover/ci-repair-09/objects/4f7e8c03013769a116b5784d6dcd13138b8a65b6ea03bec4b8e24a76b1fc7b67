 if 'HTTPS_PHASE19_FLUSH' in line:
  m=re.fullmatch(r'HTTPS_PHASE19_FLUSH events=(\d+) droppedEvents=(\d+) droppedOwners=(\d+)',line);assert m,(n,line)
  flushes.append({'line':n,'declared_events':int(m[1]),'dropped_events':int(m[2]),'dropped_owners':int(m[3]),'observed_events':0})
 elif 'HTTPS_PHASE19 ns=' in line:
  m=re.fullmatch(r'HTTPS_PHASE19 ns=(\d+) owner=(.*?) host=(\S+) event=(.*)',line);assert m,(n,line)
  assert flushes
