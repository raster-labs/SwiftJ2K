def cli_input(path):
    parts=Path(path).parts
    return (path in {'Package.swift','Package.resolved','VERSION','CLI.md'} or
        parts[0] in {'Sources','Scripts','Integration','Examples','ManPages'} or
        any(part.lower() in {'fixtures','resources'} for part in parts) or
        (parts[0]=='Tests' and not path.endswith('.swift')))
