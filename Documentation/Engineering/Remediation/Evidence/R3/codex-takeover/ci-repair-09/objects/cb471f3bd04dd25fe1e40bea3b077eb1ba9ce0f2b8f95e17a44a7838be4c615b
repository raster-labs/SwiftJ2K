def run(name, expected_exit=0, source=manifest):
    d=W/'validation'/name
    if not (d/'result.json').exists():
        assert INITIAL, ('missing required run', name)
        receipt['pending'].append(name)
        return
    c=read(d/'command.json'); r=read(d/'result.json')
    assert r['exit_code']==r['wrapper_exit_code']==expected_exit and not r['changed_inputs']
    assert read(d/'source-before.json')==read(d/'source-after.json')==source
    assert sha(d/'native.log')==r['log_sha256']
    assert r['capture_complete'] and r['capture_threads_joined'] and not r['capture_errors']
    assert r['merged_synthetic_eof_newlines']==0
    assert c['wrapper_sha256']==sha(W/'run-validation.py')
    for key,item in r['native_streams'].items():
        p=d/('native.'+key)
        assert p.resolve()==Path(item['path']).resolve()
        assert sha(p)==item['sha256'] and p.stat().st_size==item['bytes']
    assert Counter((d/'native.log').read_bytes().splitlines()) == (
        Counter((d/'native.stdout').read_bytes().splitlines()) +
        Counter((d/'native.stderr').read_bytes().splitlines()))
    for p in d.iterdir():
        if p.is_file(): record(p)
    if expected_exit==0:
        assert all(not diagnostic.search((d/n).read_text()) for n in ['native.log','native.stdout','native.stderr'])
        assert c['cwd']==str(S if source is manifest else W/'candidate-snapshot-14')
        assert c['test_environment']=={'SWIFTJ2K_TEST_CLI_PATH':None,'ASAN_OPTIONS':None,'TSAN_OPTIONS':None}
    for item in r.get('built_cli_products_at_completion',{}).values():
        assert sha(item['path'])==item['sha256']; record(item['path'])
    result={'exit_code':expected_exit,'elapsed_seconds':r['elapsed_seconds'],
        'command':c['command'],'compiler':c['compiler'],'environment':c['test_environment'],
        'log_sha256':r['log_sha256'],'source_files':len(source),'raw_capture_verified':True}
    xmlpath=d/'report-swift-testing.xml'
    if expected_exit==0 and xmlpath.exists():
        nodes=list(ET.parse(xmlpath).iter('testcase'))
        assert all(not list(n) for n in nodes)
        result['xml_swift_testing_declarations']=len(nodes)
    receipt['runs'][name]=result
    return result

