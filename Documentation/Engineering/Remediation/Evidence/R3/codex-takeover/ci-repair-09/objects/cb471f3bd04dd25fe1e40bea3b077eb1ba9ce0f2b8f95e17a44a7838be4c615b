def inventory(mode):
    d=W/'sanitizer-inventory-15'/mode
    if not (d/'inventory.json').exists():
        assert INITIAL; return None
    inv=read(d/'inventory.json')
    ids={n:(d/(n+'.ids')).read_text().splitlines() for n in ['all','jpip','complement']}
    assert [len(ids[n]) for n in ['all','jpip','complement']]==[1358,647,711]
    for values in ids.values(): assert len(values)==len(set(values)) and all(values)
    allids,jpip,other=(set(ids[n]) for n in ['all','jpip','complement'])
    assert not jpip&other and jpip|other==allids
    assert jpip=={n for n in allids if re.match(r'^SwiftJ2KJPIPTests[./]',n)}
    assert inv['selection_regex']=='^SwiftJ2KJPIPTests[./]'
    assert inv['jpip_arguments']==['--filter','^SwiftJ2KJPIPTests[./]']
    assert inv['complement_arguments']==['--skip','^SwiftJ2KJPIPTests[./]']
    for kind in ['reference','sanitized']:
        assert inv[kind]['exit_code']==0
        for stream in ['stdout','stderr']:
            assert sha(d/(kind+'.'+stream))==inv[kind][stream+'_sha256']
            assert not diagnostic.search((d/(kind+'.'+stream)).read_text())
        assert set((d/(kind+'.stdout')).read_text().splitlines())==allids
    assert '--sanitize' in inv['sanitized']['command']
    assert inv['sanitized']['command'][inv['sanitized']['command'].index('--sanitize')+1]==mode
    for p in d.iterdir():
        if p.is_file(): record(p)
    receipt['inventories'][mode]={'all':1358,'jpip':647,'complement':711,
        'all_ids_sha256':sha(d/'all.ids'),'equal_ordinary_sanitized':True,'exact_disjoint_union':True}
    return allids,jpip,other

def independently_parse(d,bindings):
    """Independent parser, not runtime-coverage/reconcile.py."""
    raw=(d/'native.stdout').read_text()
    reverse={v:k for k,v in bindings.items()}; assert len(reverse)==len(bindings)
    xcstart=Counter(a+'/'+b for a,b in re.findall(r"^Test Case '-\[([^ ]+) ([^\]]+)\]' started\.$",raw,re.M))
    xcpass=Counter(a+'/'+b for a,b in re.findall(r"^Test Case '-\[([^ ]+) ([^\]]+)\]' passed \([^\n]+\)\.$",raw,re.M))
    assert xcstart==xcpass and all(n==1 for n in xcpass.values())
    swstart=Counter(reverse[n] for n in re.findall(r'^◇ Test (?!case )(.+) started\.$',raw,re.M) if n!='run')
    swpass={}; parameters={}
    for display,count in re.findall(r'^✔ Test (.+?)(?: with (\d+) test cases?)? passed after [0-9.]+ seconds\.$',raw,re.M):
        if display.startswith('run with '): continue
        key=reverse[display]; assert key not in swpass
        swpass[key]={'status':'passed','parameter_count':int(count) if count else None}
    assert set(swstart)==set(swpass) and all(n==1 for n in swstart.values())
    for text in re.findall(r'^◇ Test case passing (.*?) started\.$',raw,re.M|re.S):
        arg,display=text.rsplit(' to ',1)
        arg=re.sub(r'^(\d+) argument ',r'\1 arguments ',arg)
        assert not any(mark in arg for mark in ['◇ Test ','✔ Test ','✘ Test ','WARNING:','ERROR:'])
        parameters.setdefault(reverse[display],Counter())[arg]+=1
    assert len(parameters)==sum(v['parameter_count'] is not None for v in swpass.values())
    for key,args in parameters.items(): assert sum(args.values())==swpass[key]['parameter_count']
    xmlids=set()
    for node in ET.parse(d/'report-swift-testing.xml').iter('testcase'):
        assert not list(node)
        a,b=node.attrib['classname'],node.attrib['name']
        matches={a+'/'+b,a+'.'+b}&set(swpass); assert len(matches)==1
        key=matches.pop(); assert key not in xmlids; xmlids.add(key)
    assert xmlids==set(swpass)
    assert not re.search(r'^✘|^↷|\bskipped\b|known issue',raw,re.M|re.I)
    return dict(xcpass),swpass,{k:dict(v) for k,v in parameters.items()}

for mode in ['thread','address']:
    sets=inventory(mode)
    proofpath=W/('r3-sanitizer-execution-proof-'+mode+'-15.json')
    if not proofpath.exists():
        assert INITIAL, ('missing required proof',mode)
        receipt['pending'].append(str(proofpath)); continue
    proof=read(proofpath); record(proofpath)
    assert proof['state']=='COMPLETE_PARTITIONED_RUNTIME_COVERAGE'
    assert proof['declared_tests']==1358 and proof['parameter_declarations']==38
    assert proof['parameter_argument_starts']==406 and not proof['unexecuted_declarations']
    spec=W/'runtime-coverage-15'/'planned-15'/(mode+'-final-15.json')
    assert sha(spec)==proof['spec_sha256']; record(spec)
    assert sha(W/'runtime-coverage'/'reconcile.py')==proof['helper_sha256']; record(W/'runtime-coverage'/'reconcile.py')
    assert receipt['manifest_sha256']==proof['source_manifest_sha256']
    assert sha(W/'sanitizer-inventory-15'/mode/'all.ids')==proof['inventory_sha256']
    for title in proof['title_source_receipts']:
        p=Path(title['source']); assert sha(p)==title['source_sha256']==manifest[str(p.relative_to(S))]
        assert title['literal'] in p.read_text().splitlines()[title['line']-1]
        assert json.loads(title['literal'])==json.loads(title['display'])
    parsed=[]; results=[]
    for obj,expected in zip([proof['ordinary'],*proof['partitions']],sets):
        for path,digest in obj['files'].items(): assert sha(path)==digest; record(path)
        d=Path(obj['directory']); xc,sw,params=independently_parse(d,proof['display_bindings'])
        assert set(xc)|set(sw)==expected and not set(xc)&set(sw)
        assert set(obj['expected_ids'])==set(obj['statuses'])==expected
        assert set(obj['statuses'].values())=={'passed'}
        assert {k:'passed' for k in xc}==obj['runtime']['xctest']
        assert sw==obj['runtime']['swift_testing'] and params==obj['runtime']['parameter_cases']
        assert not obj['runtime']['diagnostic_gaps']
        parsed.append((xc,sw,params))
        results.append({'directory':str(d),'declarations':len(xc)+len(sw),
            'xctest':len(xc),'swift_testing':len(sw),'parameter_declarations':len(params),
            'parameter_starts':sum(sum(v.values()) for v in params.values())})
    assert {**parsed[1][0],**parsed[2][0]}==parsed[0][0]
    assert {**parsed[1][1],**parsed[2][1]}==parsed[0][1]
    assert {**parsed[1][2],**parsed[2][2]}==parsed[0][2]
    receipt['proofs'][mode]={'proof_sha256':sha(proofpath),'independent_parser_matches':True,'runs':results}

