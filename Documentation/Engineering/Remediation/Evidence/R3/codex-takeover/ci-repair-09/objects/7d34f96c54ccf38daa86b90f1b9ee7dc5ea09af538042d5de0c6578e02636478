    expected = receipt.get('report_sha256') or receipt.get('files', {}).get(str(report_path)) or receipt.get('artifacts', {}).get(report_path.name)
    assert expected == sha(report_path), (report, expected)
    for name, digest in receipt.get('artifacts', {}).items():
        assert sha(source_path.parent / name) == digest, name
    reviews.append({'report': ref(report_path), 'source': ref(source_path), 'completed': True, 'supporting': []})

