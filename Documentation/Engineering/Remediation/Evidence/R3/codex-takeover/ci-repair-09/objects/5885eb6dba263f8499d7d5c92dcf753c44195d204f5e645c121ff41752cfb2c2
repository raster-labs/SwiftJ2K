def instrument_test(text, name, edits):
    start=text.index('    '+name)
    end=text.find('\n    @Test',start+1)
    if end < 0: end=text.index('\n}\n\nprivate final class HTTPSHarnessScenario',start)
    section=text[start:end]
    for old_text,new_text in edits: section=replace(section,old_text,new_text)
    return text[:start]+section+text[end:]

