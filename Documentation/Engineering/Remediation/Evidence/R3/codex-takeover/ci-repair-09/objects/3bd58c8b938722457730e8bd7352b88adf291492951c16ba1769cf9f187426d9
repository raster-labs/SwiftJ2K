    },
    'diagnostic19': {
        'state': 'INSTRUMENTED_DIAGNOSTIC_ONLY_PASS',
        'native_manifest_flag': 'diagnostic_only=true',
        'scope': 'Observed phase intervals only. Does not qualify unmodified18, close failed17/18, establish sole cause or approve a permanent policy.',
    },
    'source20_21': 'Completed source reviews only; no fresh combined22 native result or hosted success inferred.',
    'pending22': [
        'Root positively stopped/frozen22 source, exact manifest/provenance and current source/CI pins.',
        'Completed independent source22 review, including admission-fixture changes and all final deltas.',
        'Root-authorised completed native22 command/result/raw/XML/identity receipts and independent scope/coverage decisions; no unexecuted plan is treated as a pass.',
        'Stopped final documentation/PR-body pins and independent publication-wording review.',
        'New final explicit manifest, stable-source full packager dry run, root claim/review and publication decision.',
    ],
    'postpublication': 'Any subsequent exact-head hosted run is retained/reviewed separately after source publication; no future pass assumed.',
    'validation_boundary': 'This checkpoint verifies immutable record integrity only. Full helper assemble/index generation is deferred because it captures current source22 identity while that source is mutable.',
    'excluded': ['All mutable22 source/docs and invented22 native/review receipts',
                 'Binaries/build/cache/full source snapshot trees',
                 'Broad private process inventories and secret-bearing local operational commands'],
    'R3': 'NOT_ACCEPTED', 'merge_allowed': False, 'R4': 'GATED',
    'five_direct_external_gates': 'UNEXECUTED_UNWAIVED',
    'publication': 'Root only; this preparatory manifest must not be published.',
}
save('pending-inputs-01.json', pending)

paired = {str(WORK / name) for pair in pair_names for name in pair}
allowed_suffixes = {'.json', '.jsonl', '.txt', '.log', '.stdout', '.stderr', '.xml', '.ids',
                    '.py', '.swift', '.patch', '.diff', '.md', '.yml', '.yaml', '.csv'}
extra = []
for name in ['hosted-failure-review-18', 'https-diagnostic-19', 'independent-diagnostic19-review',
             'independent-diagnostic19-execution-review', 'test-portability-20',
             'independent-test-portability-20', 'worker-fixture-lifetime-21',
             'independent-worker-fixture-review-21']:
    for path in sorted((WORK / name).rglob('*')):
        if path.is_file() and '__pycache__' not in path.parts and str(path) not in paired:
            assert path.suffix.lower() in allowed_suffixes, path
            extra.append(path)
extra += [WORK / name for name in [
    'hosted-source-provider-review-18.json', 'publication-commit-18.json', 'publication-remote-commit-18.json',
    'ci-downloads/run-41198397609-attempt1-final.json', 'ci-downloads/run-41198397609-attempt1-initial.json',
    'ci-downloads/run-41198397609-tested-merge.json', 'ci-downloads/run-41198397609-workflow.yml',
    'candidate-diagnostic-19-source.json', 'candidate-diagnostic-19-provenance.json',
    'planned-https-diagnostic-19.json', 'diagnostic19-launch.json',
    'https-diagnostic-19-extracted-events.json', 'run-validation.py', 'hosted-evidence/reconstruct.py',
