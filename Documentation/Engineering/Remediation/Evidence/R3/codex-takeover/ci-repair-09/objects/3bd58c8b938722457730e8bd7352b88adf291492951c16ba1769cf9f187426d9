    ('hosted-failure-review-18/report.txt', 'hosted-failure-review-18/source.json'),
    ('https-diagnostic-19/report.txt', 'https-diagnostic-19/source.json'),
    ('independent-diagnostic19-review/report.txt', 'independent-diagnostic19-review/source.json'),
    ('independent-diagnostic19-execution-review/report.txt', 'independent-diagnostic19-execution-review/source.json'),
    ('test-portability-20/report.txt', 'test-portability-20/source.json'),
    ('independent-test-portability-20/report.txt', 'independent-test-portability-20/source.json'),
    ('worker-fixture-lifetime-21/report.txt', 'worker-fixture-lifetime-21/source.json'),
    ('independent-worker-fixture-review-21/report.txt', 'independent-worker-fixture-review-21/source.json'),
]
reviews = []
for report, source in pair_names:
    report_path, source_path = WORK / report, WORK / source
    receipt = json.loads(source_path.read_text())
    assert any(receipt.get(key) is True for key in ['stop', 'writes_stopped', 'positive_stop']), source
    expected = (receipt.get('report_sha256') or receipt.get('artifacts', {}).get('report.txt')
                or receipt.get('review_artifacts', {}).get('report.txt'))
    if isinstance(expected, dict):
        expected = expected['sha256']
    assert expected == sha(report_path), report
    reviews.append({'report': ref(report_path), 'source': ref(source_path), 'completed': True, 'supporting': []})

jobs = load(f'ci-downloads/run-{RUN}-attempt1-jobs.json')['jobs']
final_run = load(f'ci-downloads/run-{RUN}-attempt1-final.json')
assert len(jobs) == 7 and len({job['id'] for job in jobs}) == 7
assert all(job['run_id'] == RUN and job['status'] == 'completed' for job in jobs)
assert final_run['id'] == RUN and final_run['run_attempt'] == 1
assert final_run['status'] == 'completed' and final_run['conclusion'] == 'failure'
