extra += [OUT / 'pending-inputs-01.json', Path(__file__)]
assert all('/SwiftJ2K/' not in str(path) for path in extra)
assert all(path.name not in ['environment-after.json', 'other-native-after.txt'] for path in extra)
# Inspect only selected text for actual credential-shaped values without echoing them.
secret_patterns = [rb'gh[pousr]_[A-Za-z0-9]{30,}', rb'github_pat_[A-Za-z0-9_]{40,}',
                   rb'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----']
import re
for path in set(extra):
    data = path.read_bytes()
    assert not any(re.search(pattern, data) for pattern in secret_patterns), 'Secret-shaped content requires exclusion: ' + str(path)

