WORKSPACE = WORK.parent
REPO = WORK / 'SwiftJ2K'
CORPUS = REPO / 'Documentation/Engineering/Remediation/Evidence/R3/codex-takeover'
HELPER = WORK / 'ci-repair-evidence-14/package.py'
RUN = 41198397609

def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def ref(path):
    assert path.is_file() and not path.is_symlink(), path
    return {'path': str(path), 'sha256': sha(path)}

def load(name):
    return json.loads((WORK / name).read_text())

def save(name, value):
    with (OUT / name).open('x') as stream:
        json.dump(value, stream, indent=2)
        stream.write('\n')

assert sha(HELPER) == '588df7bb3fb8f100703d8cf6fc471d68ee692365974be9c18874ab72114dca83'
prior08 = CORPUS / 'generated-index.json'
assert sha(prior08) == '6dfeb1e3b90266e54d847e7ce1a5bf9096748e5d9611ed33e0a07568526f2e54'
published_indexes = [prior08]
