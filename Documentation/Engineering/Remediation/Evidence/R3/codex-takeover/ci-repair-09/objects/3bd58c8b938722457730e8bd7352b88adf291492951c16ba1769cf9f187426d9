    'candidate_label': 'Candidate22 PREPARATION ONLY while source22 is mutable: failed hosted18, diagnostic-only19, source-only20/21; no22 qualification; R3 NOT_ACCEPTED',
    'published_base_label': 'Immutable published08 plus15 b05cc28b and18 32cd2286 indexes; no current22 Git identity or qualification asserted.',
    'prior_index': ref(prior08), 'native_runs': [native], 'reviews': reviews, 'hosted_runs': [hosted],
    'supplemental': [{'file': ref(path), 'role': 'incremental22-preparation-' + path.relative_to(WORK).as_posix().replace('/', '--')}
                     for path in sorted(set(extra))],
}
