    'prepared_at': datetime.now(timezone.utc).isoformat(),
    'published_indexes_preserved': [ref(path) for path in published_indexes],
    'selection': 'Only stopped hosted18, diagnostic19, source20 and source21 records are pinned.',
    'hosted18': {
        'run': RUN, 'attempt': 1, 'state': 'FAILED',
        'macos': '1034 XCTest passed; Swift Testing324 =313 passed +6 failed +5 skipped. Sanitizers unexecuted; retention incomplete and strict reconstruction rejected.',
