    'metadata': ref(WORK / f'ci-downloads/run-{RUN}-attempt1-jobs.json'),
    'logs': [{'job_id': job['id'], 'file': ref(WORK / f"ci-downloads/run-{RUN}-attempt1-job{job['id']}.log")}
             for job in sorted(jobs, key=lambda job: job['id'])],
    'review': ref(WORK / 'hosted-failure-review-18/source.json'),
